@page "/profile/{UserId}"
@implements IDisposable
@using BlogApp.Models
@using BlogApp.Data
@using BlogApp.Services
@using MudBlazor
@inject BlogRepository BlogRepo
@inject ConnectionRepository ConnectionRepo
@inject UserProfileRepository ProfileRepo
@inject UserService UserService
@inject NavigationManager Navigation
@inject NotificationService NotificationSvc
@inject EngagementRepository EngageRepo

<div class="profile-page">
    <MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">

        @if (isLoading)
        {
            <LoadingLogo />
        }
        else
        {
            @* ── Profile Header ────────────────────────────────────────────── *@
            <div class="profile-header pa-6 mb-6">
                <div style="display:flex; align-items:center; gap:24px;">

                    @* Avatar — first letter of username, with upload affordance on own profile *@
                    <div style="position:relative; flex-shrink:0;">
                        <AvatarInitial DisplayName="@(profileOwner?.Username ?? UserId)" Size="lg" />
                        @if (IsOwnProfile)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.CameraAlt"
                                           Href="/settings"
                                           Size="Size.Small"
                                           Class="avatar-upload-btn" />
                        }
                    </div>

                    <div style="display:flex; flex-direction:column; gap:8px; flex:1;">
                        <MudText Class="profile-username">
                            @(profileOwner != null ? profileOwner.Username : UserId.Substring(0, 8) + "...")
                        </MudText>

                        @* Posts / Followers / Following / Friends — identical visual weight, last three are clickable *@
                        <div style="display:flex; align-items:center; gap:24px;">
                            <MudText Class="stat-text">
                                <span class="stat-num">@userPosts.Count</span>
                                <span class="stat-label">posts</span>
                            </MudText>
                            <MudText Class="stat-text stat-clickable" @onclick='() => OpenList("followers")'>
                                <span class="stat-num">@followerCount</span>
                                <span class="stat-label">followers</span>
                            </MudText>
                            <MudText Class="stat-text stat-clickable" @onclick='() => OpenList("following")'>
                                <span class="stat-num">@followingCount</span>
                                <span class="stat-label">following</span>
                            </MudText>
                            <MudText Class="stat-text stat-clickable" @onclick='() => OpenList("friends")'>
                                <span class="stat-num">@friendCount</span>
                                <span class="stat-label">friends</span>
                            </MudText>
                        </div>
                    </div>

                    @* ── Action Buttons ──────────────────────────────────────── *@
                    @if (!IsOwnProfile)
                    {
                        <div style="display:flex; gap:8px;">

                            @* Follow / Unfollow Button *@
                            @if (isFollowing)
                            {
                                <MudButton Variant="Variant.Outlined"
                                           Class="btn-outline-neutral"
                                           OnClick="UnfollowUser">
                                    Following &#10003;
                                </MudButton>
                            }
                            else
                            {
                                <MudButton Variant="Variant.Filled"
                                           Class="btn-accent-filled"
                                           OnClick="FollowUser">
                                    Follow
                                </MudButton>
                            }

                            @* Friend Request Button *@
                            @if (friendStatus == "accepted")
                            {
                                <MudButton Variant="Variant.Outlined"
                                           Class="btn-outline-success"
                                           OnClick="Unfriend">
                                    Friends &#10003;
                                </MudButton>
                            }
                            else if (friendStatus == "pending_sent")
                            {
                                <MudButton Variant="Variant.Outlined"
                                           Class="btn-outline-muted"
                                           OnClick="CancelFriendRequest">
                                    Request Sent
                                </MudButton>
                            }
                            else if (friendStatus == "pending_received")
                            {
                                <MudButton Variant="Variant.Filled"
                                           Class="btn-success-filled"
                                           OnClick="AcceptRequest">
                                    Accept Friend Request
                                </MudButton>
                            }
                            else
                            {
                                <MudButton Variant="Variant.Outlined"
                                           Class="btn-outline-accent"
                                           OnClick="SendFriendRequest">
                                    Add Friend
                                </MudButton>
                            }

                        </div>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Class="btn-outline-accent"
                                   Href="/settings">
                            Edit profile
                        </MudButton>
                    }
                </div>
            </div>

            @* ── Pending Friend Requests (own profile only) ────────────────── *@
            @if (IsOwnProfile && pendingRequests.Count > 0)
            {
                <MudText Class="section-heading mb-2">Friend Requests (@pendingRequests.Count)</MudText>
                @foreach (var req in pendingRequests)
                {
                    <div class="request-row pa-3 mb-2">
                        <div style="display:flex; align-items:center; gap:12px;">
                            <AvatarInitial DisplayName="@requesterNames.GetValueOrDefault(req.FollowerUserId, "?")" Size="sm" />
                            <MudLink Href="@($"/profile/{req.FollowerUserId}")" Class="request-name-link" Style="flex:1">
                                @requesterNames.GetValueOrDefault(req.FollowerUserId, req.FollowerUserId.Substring(0, 8) + "...").TrimStart('@')
                            </MudLink>
                            <MudButton Variant="Variant.Filled" Class="btn-success-filled" Size="Size.Small"
                                       OnClick="() => AcceptSpecificRequest(req.Id!)">
                                Accept
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Class="btn-outline-error" Size="Size.Small"
                                       OnClick="() => DeclineRequest(req.Id!)">
                                Decline
                            </MudButton>
                        </div>
                    </div>
                }
                <MudDivider Class="mb-4 mt-2" />
            }

            @* ── Posts / Saved tabs ───────────────────────────────────────── *@
            <MudTabs Elevation="0" ActivePanelIndex="activeTabIndex" ActivePanelIndexChanged="OnTabChanged" Class="profile-tabs">
                <MudTabPanel Text="POSTS">
                    @if (userPosts.Count == 0)
                    {
                        <div class="empty-state-box pa-8 text-center mt-4">
                            <MudIcon Icon="@Icons.Material.Outlined.CameraAlt" Size="Size.Large" Class="empty-icon" />
                            <MudText Class="empty-title">
                                @(IsOwnProfile ? "Share blogs" : "No posts yet")
                            </MudText>
                            <MudText Class="empty-subtitle mt-1">
                                @(IsOwnProfile ? "When you share a blog, it will appear on your profile." : "This user hasn't shared anything yet.")
                            </MudText>
                        </div>
                    }
                    else
                    {
                        <div style="display:flex; flex-direction:column; gap:20px; margin-top:8px;">
                            @foreach (var post in userPosts)
                            {
                                var postId = post.Id;
                                <div class="post-card" @onclick="@(() => Navigation.NavigateTo("/post/" + postId))" style="cursor:pointer;">
                                    <div style="display:flex; align-items:center; gap:8px; margin-bottom:10px;">
                                        <AvatarInitial DisplayName="@(profileOwner?.Username ?? UserId)" Size="sm" />
                                        <div>
                                            <span class="author-link-text">@(profileOwner?.Username ?? UserId)</span>
                                            <span class="meta-text"> &middot; @post.CreatedAt.ToString("dd MMM yyyy")</span>
                                        </div>
                                        <span class="@("visibility-pill-sm " + GetVisibilityClass(post.Visibility))" style="margin-left:auto;">@post.Visibility</span>
                                        @if (IsOwnProfile)
                                        {
                                            <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true"
                                                     Class="muted-icon"
                                                     AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight"
                                                     @onclick:stopPropagation="true">
                                                <MudMenuItem OnClick="@(() => Navigation.NavigateTo("/editor/" + postId))">Edit</MudMenuItem>
                                                <MudMenuItem OnClick="@(() => Navigation.NavigateTo("/post/" + postId))">View</MudMenuItem>
                                            </MudMenu>
                                        }
                                    </div>
                                    <div class="post-card-body">
                                        <div class="post-card-text">
                                            <div class="post-title">@post.Title</div>
                                            <p class="post-preview">@StripMarkdown(post.Content ?? "")</p>
                                            @if (post.Tags is { Count: > 0 })
                                            {
                                                <div style="display:flex; gap:8px; flex-wrap:wrap;">
                                                    @foreach (var tag in post.Tags)
                                                    {
                                                        <span class="tag-text">#@tag</span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(post.ImageUrl))
                                        {
                                            <div class="post-card-thumb">
                                                <img src="@post.ImageUrl" alt="@post.Title" />
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </MudTabPanel>

                @if (IsOwnProfile)
                {
                    <MudTabPanel Text="SAVED">
                        @if (!savedPostsLoaded)
                        {
                            <LoadingLogo />
                        }
                        else if (savedPosts.Count == 0)
                        {
                            <div class="empty-state-box pa-8 text-center mt-4">
                                <MudIcon Icon="@Icons.Material.Outlined.BookmarkBorder" Size="Size.Large" Class="empty-icon" />
                                <MudText Class="empty-title">No saved posts</MudText>
                                <MudText Class="empty-subtitle mt-1">
                                    Posts you save will appear here. Only you can see this.
                                </MudText>
                            </div>
                        }
                        else
                        {
                            <div style="display:flex; flex-direction:column; gap:20px; margin-top:8px;">
                                @foreach (var post in savedPosts)
                                {
                                    var savedPostId = post.Id;
                                    <div class="post-card" @onclick="@(() => Navigation.NavigateTo("/post/" + savedPostId))" style="cursor:pointer;">
                                        <div style="display:flex; align-items:center; gap:8px; margin-bottom:10px;">
                                        <AvatarInitial DisplayName="@(post.AuthorId ?? "?")" Size="sm" />
                                            <div>
                                                <span class="author-link-text meta-text">@post.CreatedAt.ToString("dd MMM yyyy")</span>
                                            </div>
                                            <span class="@("visibility-pill-sm " + GetVisibilityClass(post.Visibility))" style="margin-left:auto;">@post.Visibility</span>
                                        </div>
                                        <div class="post-card-body">
                                            <div class="post-card-text">
                                                <div class="post-title">@post.Title</div>
                                                <p class="post-preview">@MarkdownHelper.StripMarkdown(post.Content ?? "")</p>
                                                @if (post.Tags is { Count: > 0 })
                                                {
                                                    <div style="display:flex; gap:8px; flex-wrap:wrap;">
                                                        @foreach (var tag in post.Tags)
                                                        {
                                                            <span class="tag-text">#@tag</span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                            @if (!string.IsNullOrEmpty(post.ImageUrl))
                                            {
                                                <div class="post-card-thumb">
                                                    <img src="@post.ImageUrl" alt="@post.Title" />
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </MudTabPanel>
                }
            </MudTabs>
        }
    </MudContainer>
</div>

@* ── Followers / Following / Friends Overlay ──────────────────────────
     Rendered OUTSIDE MudContainer so it isn't clipped by layout layers *@
@if (listDialogOpen)
{
    <div class="dialog-backdrop" @onclick="CloseList">
        @* Inner div stops backdrop click from closing when clicking inside the panel *@
        <div @onclick:stopPropagation="true">
            <div class="dialog-panel pa-6">
                <MudText Class="dialog-title mb-4">@listDialogTitle</MudText>
                @if (listDialogUsers.Count == 0)
                {
                    <MudText Class="empty-subtitle">Nobody here yet.</MudText>
                }
                else
                {
                    @foreach (var user in listDialogUsers)
                    {
                        <div style="display:flex; align-items:center; gap:8px;" class="mb-3">
                            <AvatarInitial DisplayName="@user.Value" Size="sm" />
                            <MudButton Variant="Variant.Text"
                                       Href="@($"/profile/{user.Key}")"
                                       OnClick="CloseList"
                                       Class="list-name-btn"
                                       Style="justify-content:flex-start; flex:1;">
                                @user.Value
                            </MudButton>
                        </div>
                    }
                }
                <MudDivider Class="mt-4 mb-3" />
                <MudButton OnClick="CloseList" Variant="Variant.Outlined" Class="btn-outline-neutral" FullWidth="true">Close</MudButton>
            </div>
        </div>
    </div>
}

