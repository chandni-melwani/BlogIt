@code {
    [Parameter] public string UserId { get; set; } = "";

    private bool isLoading = true;

    // Profile data
    private BlogApp.Models.UserProfile? profileOwner = null;
    private string senderUsername = "";
    private Dictionary<string, string> requesterNames = new();

    // Posts + pending requests
    private List<BlogPost> userPosts = new();
    private List<UserConnection> pendingRequests = new();

    // Counts
    private int followerCount = 0;
    private int followingCount = 0;
    private int friendCount = 0;

    // Relationship state
    private bool isFollowing = false;
    private string friendStatus = "none";
    private string? pendingConnectionId = null;

    // Dialog state
    private bool listDialogOpen = false;
    private string listDialogTitle = "";
    private Dictionary<string, string> listDialogUsers = new();

    private bool _isDisposed = false;

    private int activeTabIndex = 0;
    private List<BlogPost> savedPosts = new();
    private bool savedPostsLoaded = false;

    // Compares trimmed lowercase to avoid whitespace/casing mismatches
    private bool IsOwnProfile =>
        UserId.Trim().ToLower() == (UserService.UserId ?? "").Trim().ToLower();

    // Track the last loaded UserId so we can detect parameter changes
    private string _lastUserId = "";

    protected override async Task OnInitializedAsync()
    {
        UserService.OnSessionReady += OnSessionReady;
        _lastUserId = UserId;

        await LoadPublicProfileData();

        if (UserService.IsLoggedIn)
        {
            await LoadRelationshipState();
            isLoading = false;
        }
        // If not logged in yet, leave isLoading = true
        // OnSessionReady will set it to false when ready
    }

    private async Task LoadPublicProfileData()
    {
        var allPostsTask = BlogRepo.GetByAuthorIdAsync(UserId);
        var followersTask = ConnectionRepo.GetFollowersAsync(UserId);
        var followingTask = ConnectionRepo.GetFollowingAsync(UserId);
        var friendsTask = ConnectionRepo.GetFriendsAsync(UserId);

        await Task.WhenAll(allPostsTask, followersTask, followingTask, friendsTask);

        var allPosts = allPostsTask.Result;
        followerCount = followersTask.Result.Count;
        followingCount = followingTask.Result.Count;
        friendCount = friendsTask.Result.Count;

        profileOwner = await ProfileRepo.GetByUserIdAsync(UserId);

        // Filter posts by visibility — session-dependent part
        if (IsOwnProfile)
        {
            userPosts = allPosts;
        }
        else
        {
            bool viewerFollows = UserService.IsLoggedIn &&
                await ConnectionRepo.IsFollowingAsync(UserService.UserId!, UserId);

            bool viewerIsFriend = false;
            if (UserService.IsLoggedIn)
            {
                var friends = friendsTask.Result;
                viewerIsFriend = friends.Any(c =>
                    c.FollowerUserId == UserService.UserId ||
                    c.FollowingUserId == UserService.UserId);
            }

            userPosts = allPosts.Where(p =>
            {
                if (p.Visibility == "Public") return true;
                if (p.Visibility == "Followers" && viewerFollows) return true;
                if (p.Visibility == "Private" && viewerIsFriend) return true;
                return false;
            }).ToList();
        }

        // Newest first — GetByAuthorIdAsync doesn't guarantee order
        userPosts = userPosts.OrderByDescending(p => p.CreatedAt).ToList();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (UserId != _lastUserId)
        {
            _lastUserId = UserId;
            isLoading = true;
            listDialogOpen = false;

            isFollowing = false;
            friendStatus = "none";
            pendingConnectionId = null;
            pendingRequests = new();
            requesterNames = new();

            await LoadPublicProfileData();

            if (UserService.IsLoggedIn)
            {
                await LoadRelationshipState();
            }

            isLoading = false;
            StateHasChanged();
        }
    }

    private async void OnSessionReady()
    {
        if (_isDisposed) return;

        await InvokeAsync(async () =>
        {
            if (_isDisposed) return;

            await LoadPublicProfileData();
            await LoadRelationshipState();

            if (IsOwnProfile)
            {
                pendingRequests = await ConnectionRepo.GetPendingRequestsAsync(UserId);
                if (pendingRequests.Count > 0)
                {
                    var requesterIds = pendingRequests.Select(r => r.FollowerUserId).ToList();
                    requesterNames = await ProfileRepo.GetDisplayNamesAsync(requesterIds);
                }
            }

            isLoading = false;
            StateHasChanged();
        });
    }



    /// <summary>
    /// Loads follow/friend relationship state between current user and profile owner.
    /// Safe to call multiple times (idempotent).
    /// </summary>
    private async Task LoadRelationshipState()
    {
        // Load sender username (for notification messages)
        if (UserService.IsLoggedIn)
        {
            var myUsername = UserService.Username ?? UserService.UserId!.Substring(0, 8);
            senderUsername = myUsername;
        }

        if (!IsOwnProfile && UserService.IsLoggedIn)
        {
            isFollowing = await ConnectionRepo.IsFollowingAsync(UserService.UserId!, UserId);

            var sentRequest = await ConnectionRepo.GetConnectionAsync(UserService.UserId!, UserId);
            var receivedRequest = await ConnectionRepo.GetConnectionAsync(UserId, UserService.UserId!);

            if (sentRequest?.Type == "friend" && sentRequest.Status == "accepted")
                friendStatus = "accepted";
            else if (receivedRequest?.Type == "friend" && receivedRequest.Status == "accepted")
                friendStatus = "accepted";
            else if (sentRequest?.Type == "friend" && sentRequest.Status == "pending")
                friendStatus = "pending_sent";
            else if (receivedRequest?.Type == "friend" && receivedRequest.Status == "pending")
            {
                friendStatus = "pending_received";
                pendingConnectionId = receivedRequest.Id;
            }
            else
            {
                friendStatus = "none";
            }
        }

        // If we're now on our own profile but loaded with stale data, also load pending requests
        if (IsOwnProfile && pendingRequests.Count == 0)
        {
            pendingRequests = await ConnectionRepo.GetPendingRequestsAsync(UserId);
            if (pendingRequests.Count > 0)
            {
                var requesterIds = pendingRequests.Select(r => r.FollowerUserId).ToList();
                requesterNames = await ProfileRepo.GetDisplayNamesAsync(requesterIds);
            }
        }
    }

    private async Task FollowUser()
    {
        if (isFollowing || IsOwnProfile) return;

        await ConnectionRepo.FollowAsync(UserService.UserId!, UserId);
        isFollowing = true;
        followerCount++;

        await NotificationSvc.SendAsync(
            toUserId: UserId,
            fromUserId: UserService.UserId!,
            message: $"{senderUsername} started following you",
            type: "follow"
        );
    }

    private async Task UnfollowUser()
    {
        await ConnectionRepo.UnfollowAsync(UserService.UserId!, UserId);
        isFollowing = false;
        followerCount--;
    }

    private async Task SendFriendRequest()
    {
        if (IsOwnProfile) return;

        await ConnectionRepo.SendFriendRequestAsync(UserService.UserId!, UserId);
        friendStatus = "pending_sent";

        await NotificationSvc.SendAsync(
            toUserId: UserId,
            fromUserId: UserService.UserId!,
            message: $"{senderUsername} sent you a friend request",
            type: "friend_request"
        );
    }

    private async Task AcceptRequest()
    {
        if (pendingConnectionId is not null)
        {
            await ConnectionRepo.AcceptFriendRequestAsync(pendingConnectionId);
            friendStatus = "accepted";
            friendCount++;

            await NotificationSvc.SendAsync(
                toUserId: UserId,
                fromUserId: UserService.UserId!,
                message: $"{senderUsername} accepted your friend request",
                type: "friend_request"
            );
        }
    }

    private async Task AcceptSpecificRequest(string connectionId)
    {
        var req = pendingRequests.FirstOrDefault(r => r.Id == connectionId);

        await ConnectionRepo.AcceptFriendRequestAsync(connectionId);
        pendingRequests.RemoveAll(r => r.Id == connectionId);
        friendCount++;

        if (req is not null)
        {
            var myUsername = UserService.Username ?? UserService.UserId!.Substring(0, 8);
            await NotificationSvc.SendAsync(
                toUserId: req.FollowerUserId,
                fromUserId: UserService.UserId!,
                message: $"{myUsername} accepted your friend request",
                type: "friend_request"
            );
        }
    }

    private async Task DeclineRequest(string connectionId)
    {
        await ConnectionRepo.DeclineFriendRequestAsync(connectionId);
        pendingRequests.RemoveAll(r => r.Id == connectionId);
    }

    private async Task Unfriend()
    {
        var conn = await ConnectionRepo.GetConnectionAsync(UserService.UserId!, UserId);
        conn ??= await ConnectionRepo.GetConnectionAsync(UserId, UserService.UserId!);

        if (conn is not null)
        {
            await ConnectionRepo.DeclineFriendRequestAsync(conn.Id!);
            friendStatus = "none";
            friendCount--;
        }
    }

    private async Task CancelFriendRequest()
    {
        var conn = await ConnectionRepo.GetConnectionAsync(UserService.UserId!, UserId);
        if (conn is not null)
        {
            await ConnectionRepo.DeclineFriendRequestAsync(conn.Id!);
            friendStatus = "none";
        }
    }

    private string GetVisibilityClass(string v) => VisibilityHelper.GetVisibilityClass(v);

    private string StripMarkdown(string text) => MarkdownHelper.StripMarkdown(text);

    /// <summary>
    /// Opens the followers/following/friends overlay dialog.
    /// Uses InvokeAsync(StateHasChanged) for proper Blazor Server SignalR threading.
    /// </summary>
    private async Task OpenList(string type)
    {
        listDialogUsers = new();

        if (type == "followers")
        {
            listDialogTitle = "Followers";
            var followers = await ConnectionRepo.GetFollowersAsync(UserId);
            var ids = followers.Select(c => c.FollowerUserId).ToList();
            if (ids.Count > 0)
                listDialogUsers = await ProfileRepo.GetDisplayNamesAsync(ids);
        }
        else if (type == "following")
        {
            listDialogTitle = "Following";
            var following = await ConnectionRepo.GetFollowingAsync(UserId);
            var ids = following.Select(c => c.FollowingUserId).ToList();
            if (ids.Count > 0)
                listDialogUsers = await ProfileRepo.GetDisplayNamesAsync(ids);
        }
        else if (type == "friends")
        {
            listDialogTitle = "Friends";
            var friends = await ConnectionRepo.GetFriendsAsync(UserId);
            var ids = friends
                .Select(c => c.FollowerUserId == UserId ? c.FollowingUserId : c.FollowerUserId)
                .ToList();
            if (ids.Count > 0)
                listDialogUsers = await ProfileRepo.GetDisplayNamesAsync(ids);
        }

        listDialogOpen = true;
        await InvokeAsync(StateHasChanged);
    }

    private void CloseList()
    {
        listDialogOpen = false;
    }

    /// <summary>
    /// Unsubscribe from UserService event to prevent memory leaks.
    /// </summary>
    public void Dispose()
    {
        _isDisposed = true;
        UserService.OnSessionReady -= OnSessionReady;
    }

    private async Task OnTabChanged(int index)
    {
        activeTabIndex = index;

        // Lazy-load saved posts only the first time the Saved tab is opened
        if (index == 1 && IsOwnProfile && !savedPostsLoaded)
        {
            var savedIds = await EngageRepo.GetAllSavedPostIdsAsync(UserId);
            savedPosts = savedIds.Count > 0
                ? (await BlogRepo.GetByIdsAsync(savedIds)).OrderByDescending(p => p.CreatedAt).ToList()
                : new List<BlogPost>();
            savedPostsLoaded = true;
            StateHasChanged();
        }
    }
}
